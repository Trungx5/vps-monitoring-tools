# Caddy reverse proxy for the VPS monitor.
#
# Caddy is suggested over nginx here purely because it obtains and renews
# Let's Encrypt certificates automatically with no extra tooling.
#
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Replace the domain below with your own. The domain's DNS A record must
# already point at this server, and ports 80 and 443 must be reachable, or
# certificate issuance fails.

# Using a free DuckDNS name instead of your own domain? Replace the line below
# with your subdomain and everything else works unchanged - Let's Encrypt
# issues certificates for *.duckdns.org normally:
#
#     yourname.duckdns.org {
#         encode gzip
#         reverse_proxy 127.0.0.1:5000
#     }
#
# Ports 80 and 443 must be open in the EC2 Security Group. Port 80 is required
# for the certificate challenge even though the site itself runs on 443, and
# Caddy redirects it to HTTPS afterwards. Do NOT open port 5000 - the app is
# only meant to be reachable through this proxy.

monitor.example.com {
    encode gzip

    # The dashboard polls a few endpoints every 5-10s; keep the proxy from
    # cutting those off early.
    reverse_proxy 127.0.0.1:5000 {
        header_up X-Real-IP {remote_host}
        transport http {
            read_timeout 60s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }

    log {
        output file /var/log/caddy/vpsmon.log
        format console
    }
}

# --- nginx equivalent, if you would rather use nginx --------------------------
