[Unit]
Description=VPS Monitor - web dashboard
After=network.target vpsmon-scraper.service
Wants=vpsmon-scraper.service

[Service]
Type=notify
User=vpsmon
Group=vpsmon
WorkingDirectory=/opt/vpsmon/app
EnvironmentFile=/etc/vpsmon/vpsmon.env
# The account home (/opt/vpsmon) is read-only under ProtectSystem=strict,
# so point HOME at the writable data dir - gunicorn and friends drop dot
# directories there and log errors on every start otherwise.
Environment=HOME=/opt/vpsmon/data

# Runs once per service start (not per worker), so the database is ready
# before any worker accepts a request. Add --rotate-sessions here if you want
# every deploy to force all users to sign in again.
ExecStartPre=/opt/vpsmon/venv/bin/python cli.py init

ExecStart=/opt/vpsmon/venv/bin/gunicorn -c gunicorn.conf.py wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

# Hardening: the service only ever needs to write its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vpsmon/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
