# VPS Monitor configuration.
#
# Install to /etc/vpsmon/vpsmon.env and lock it down - it holds the session
# signing key and SMTP password:
#     sudo chown root:vpsmon /etc/vpsmon/vpsmon.env
#     sudo chmod 640 /etc/vpsmon/vpsmon.env
#
# systemd reads this file literally: no quotes, no $VAR expansion, no inline
# comments after a value.

# --- paths -----------------------------------------------------------------
DB_PATH=/opt/vpsmon/data/metrics.db
LOG_FILE_PATH=/opt/vpsmon/data/vps_monitor.log

# --- web service -----------------------------------------------------------
# Bind to localhost only; the reverse proxy is what faces the internet.
BIND=127.0.0.1:5000
WEB_WORKERS=3
WEB_THREADS=2

# Generate once with:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everyone out.
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_HEX_STRING

# Set both of these once TLS is terminated by the proxy in front.
SECURE_COOKIES=1
BEHIND_PROXY=1
PROXY_HOPS=1

# How long a login lasts before it must be repeated.
SESSION_LIFETIME_HOURS=12

# --- first admin account ---------------------------------------------------
# Only used the very first time the database is created. After that, manage
# accounts with `vpsmon user ...` or the Users panel. Remove these lines once
# the account exists so the password is not sitting in a config file.
APP_USERNAME=admin
APP_PASSWORD=CHANGE_ME_BEFORE_FIRST_START

# --- email alerts ----------------------------------------------------------
# Without these, alerts are written to the log instead of emailed.
# For Gmail use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
ALERT_FROM_EMAIL=you@example.com

# --- small devices (Raspberry Pi and similar) -------------------------------
# Every scrape writes a row per instance, so on SD-card storage the interval is
# the main lever on both disk wear and CPU. Uncomment to trade resolution for
# a much lighter footprint.
# SCRAPE_INTERVAL_SECONDS=30
# HEARTBEAT_INTERVAL_SECONDS=60
# WEB_CHECK_INTERVAL_SECONDS=300
# IP_CHECK_INTERVAL_SECONDS=120
# METRICS_RETENTION_DAYS=7
# WEB_WORKERS=2
